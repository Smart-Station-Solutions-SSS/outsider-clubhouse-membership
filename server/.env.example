# Server
PORT=4100
NODE_ENV=development
# Browser origin of the web app (used in emails + Paymob return redirect)
WEB_PUBLIC_URL=http://localhost:5174
# Public URL of this API (Paymob webhook/return must reach it)
API_PUBLIC_BASE_URL=http://localhost:4100

DATABASE_URL=postgresql://postgres:123456@localhost:5432/outsider-clubhouse-membership?schema=public
TEST_DATABASE_URL=postgresql://postgres:123456@localhost:5432/outsider-clubhouse-membership-test?schema=public

JWT_SECRET=
PII_ENCRYPTION_KEY=
PII_HASH_KEY=

# National ID OCR (gates server)
GATES_OCR_URL=https://gates.hpd-lc.com
GATES_OCR_API_KEY=
GATES_OCR_TIMEOUT_MS=15000

# Paymob — the same merchant account as SSS-Community-App (its .env + dashboard Integrations → Paymob)
PAYMOB_ENABLED=true
PAYMOB_FLOW_TYPE=LEGACY_IFRAME
# LEGACY_IFRAME needs API_KEY + IFRAME_ID; UNIFIED_CHECKOUT needs SECRET_KEY + PUBLIC_KEY
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_IFRAME_ID=
# Required. Not in SSS's .env — SSS keeps it in its dashboard settings; Paymob dashboard → Developers → Payment Integrations (Card)
PAYMOB_CARD_INTEGRATION_ID=
# Recommended; without it each callback is checked by reading the transaction back with the API key
PAYMOB_HMAC_SECRET=
# Local dev only: fake checkout that marks orders paid without charging a card.
# Ignored unless WEB_PUBLIC_URL is localhost and NODE_ENV is not production — set false on staging/production.
PAYMOB_MOCK=true

# Email (leave SMTP_HOST empty to log emails to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Clubhouse <no-reply@clubhouse.local>

# SSS-Community-App: plans, age bands and prices are synced from its Clubhouse settings
SSS_API_URL=
SSS_SYNC_KEY=

UPLOAD_DIR=./uploads
